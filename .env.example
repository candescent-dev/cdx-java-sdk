# Candescent Digital Insight SDK - Environment Variables Template
# Copy this file to .env and fill in your credentials

# ── Required for all SDKs ──────────────────────────────────────────────────
CANDESCENT_INSTITUTION_ID=your-institution-id
CANDESCENT_CLIENT_ID=your-client-id
CANDESCENT_CLIENT_SECRET=your-client-secret

# ── Optional: Environment (defaults to "stage") ────────────────────────────
# CANDESCENT_ENVIRONMENT=stage
# CANDESCENT_ENVIRONMENT=production

# ── Optional: OAuth Grant Type ─────────────────────────────────────────────
# Use password grant instead of client_credentials (uncomment if needed):
# CANDESCENT_USERNAME=your-username
# CANDESCENT_PASSWORD=your-password

# ── Optional: Skip OAuth (use static bearer token) ─────────────────────────
# CANDESCENT_BEARER_TOKEN=your-static-bearer-token
# Leave unset when using CLIENT_ID + CLIENT_SECRET so examples use live OAuth.

# ── authentication.ts: OIDC auth-code flow ─────────────────────────────────
# CANDESCENT_OIDC_CLIENT_ID — client_id for POST /auth-code/v1/* (often differs from CLIENT_ID)
# CANDESCENT_APIGEE_BASE_URL=https://api.candescent.com/digitalbanking/stage
# CANDESCENT_AUTH_NONCE=candescent1234

# ── Optional: Password grant (authentication.ts only) ─────────────────────
# If set in .env, CandescentClient.fromEnv() uses ROPC instead of client_credentials.
# CANDESCENT_OAUTH_GRANT=password
# CANDESCENT_USERNAME=kbuser
# CANDESCENT_PASSWORD=your-password
#
# Staging accounts Postman env (apigee-accounts-stg) maps roughly as:
#   client_id/secret, institution_id 05529, retail_user_host_user_id → HOST_USER_ID
#   retail_user_login_id → LOGIN_ID, business_user_login_id → BB_LOGIN_ID

# ── Example-specific: User Identifiers ─────────────────────────────────────
# For examples that require a user context (accounts, transactions, etc.)
# Provide ONE of the following (NOT BOTH - they are mutually exclusive):

CANDESCENT_HOST_USER_ID=your-host-user-id
# CANDESCENT_LOGIN_ID=your-login-id

# ── Example-specific: Customer & User IDs ──────────────────────────────────
# For customer-management, user-status, and register-and-lookup examples:

CANDESCENT_CUSTOMER_ID=your-customer-guid
# CANDESCENT_INSTITUTION_USER_ID=your-institution-user-id
# CANDESCENT_INSTITUTION_CUSTOMER_ID=your-institution-customer-id
# CANDESCENT_FI_ID=your-fi-id

# ── Example-specific: Account & Subscription IDs ───────────────────────────
# Required for examples that fetch specific resources:

CANDESCENT_ACCOUNT_ID=your-account-id
CANDESCENT_SUBSCRIPTION_ID=your-subscription-id

# ── Example-specific: Alert Configuration ──────────────────────────────────
# For alert-configuration and alert-preferences examples:

CANDESCENT_ALERT_TEMPLATE_ID=your-alert-template-id
CANDESCENT_ALERT_TYPE_NAME=your-alert-type-name
CANDESCENT_ALERT_PREF_ID=your-alert-preference-id

# ── Example-specific: Business Banking ─────────────────────────────────────
# For business-entitlements and business-payments (apigee-bb-stg Postman environment):
#   CANDESCENT_BB_CLIENT_ID, CANDESCENT_BB_CLIENT_SECRET, CANDESCENT_BB_INSTITUTION_ID
#   CANDESCENT_APIGEE_BASE_URL (maps to Postman apigee_base_url)
# business-registration still uses CANDESCENT_CLIENT_*.

# CANDESCENT_APIGEE_BASE_URL=https://api.candescent.com/digitalbanking/stage
CANDESCENT_BB_CLIENT_ID=your-bb-client-id
CANDESCENT_BB_CLIENT_SECRET=your-bb-client-secret
# CANDESCENT_BB_INSTITUTION_ID=05529

CANDESCENT_USER_UUID=your-user-uuid
CANDESCENT_BB_LOGIN_ID=your-bb-login-id
CANDESCENT_BB_BUSINESS_ID=your-bb-business-id
# CANDESCENT_BB_ACCOUNT_ID=your-bb-originating-account-number  (entitlements bankAccounts.accountNumber)
# CANDESCENT_BB_TIN_NUMBER=your-bb-tin  (entitledTins.tinNumber for that account)
# CANDESCENT_BB_ACH_COMPANY_ID=your-ach-company-id  (user entitlements achCompanyIds)
# CANDESCENT_BB_INSTITUTION_CUSTOMER_ID=your-bb-institution-customer-id
# CANDESCENT_BB_FEATURE_NAME=your-bb-feature-name

# ── Example-specific: MX Integration ───────────────────────────────────────
# For mx-service example (requires separate MX credentials):

CANDESCENT_MX_CLIENT_ID=your-mx-client-id
CANDESCENT_MX_API_KEY=your-mx-api-key
CANDESCENT_MX_HOST=int-widgets.moneydesktop.com
# CANDESCENT_MX_USER_ID=your-mx-user-id

# ── Example-specific: Fallback IDs ─────────────────────────────────────────
# For examples that create resources and then look them up.
# Set these to skip the creation step and test lookups directly:

# FALLBACK_CUSTOMER_ID=your-known-customer-guid
# FALLBACK_RECIPIENT_ID=your-known-recipient-id

# ── DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS ──────────────────────────
# Add .env to .gitignore to prevent accidental credential leaks
